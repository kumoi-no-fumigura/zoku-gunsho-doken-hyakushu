  },
  {
   "seq": "11",
   "text": "塩竃のうらみなれつる夕喫かすみの月にいかゝこゆらん",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "塩竃浦",
   "kotobagaki": ""
  },
  {
   "seq": "12",
   "text": "一立きよふ芦屋の里の夕露花にやととふ行東のみかは",
   "kana": "",
   "speaker": "",
   "page": 2,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "芦屋里",
   "kotobagaki": ""
  },
  {
   "seq": "13",
   "text": "散花を吹上の浜の白波にまかふもつらし興津塩風",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "吹上浜",
   "kotobagaki": ""
  },
  {
   "seq": "14",
   "text": "春のかの艮のみさきに舟漕て遠くも浪の花をみし哉",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "由良三崎",
   "kotobagaki": ""
  },
  {
   "seq": "15",
   "text": "暮て行は成をはいから忍ふ山風にしられぬ花はありとも",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "忍山",
   "kotobagaki": ""
  },
  {
   "seq": "16",
   "text": "わきて見は皆人も見なせ川山もとかすむ花の下道",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水無瀬川",
   "kotobagaki": ""
  },
  {
   "seq": "17",
   "text": "うつり行浪に心は大淀のうらみかねてもかへる春かな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "大豆浦",
   "kotobagaki": ""
  },
  {
   "seq": "18",
   "text": "一長問にて田子の浦風殿へぬ日も又ちりかゝる藤浪のはな",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田籠浦",
   "kotobagaki": ""
  },
  {
   "seq": "19",
   "text": "年こえし空も程なく見るかうちにかはるや春の末の雲山",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "末松山",
   "kotobagaki": ""
  },
  {
   "seq": "20",
   "text": "一大井川いせきによとむ春の立は浪間にさらす夏衣哉",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "大井川",
   "kotobagaki": ""
  },
  {
   "seq": "21",
   "text": "たちぬれてたれか聞らん子親しのましつたの杜の下露",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "篠田森",
   "kotobagaki": ""
  },
  {
   "seq": "22",
   "text": "一時鳥またやはたのむこひすてしいなの小藻かりに逢夜を",
   "kana": "",
   "speaker": "",
   "page": 3,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "猪名野",
   "kotobagaki": ""
  },
  {
   "seq": "23",
   "text": "神風や見もすそ川の浪枕心涼しき旅にもあるかな",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "御裳濯川",
   "kotobagaki": ""
  },
  {
   "seq": "24",
   "text": "あやめ引いかほの浪のいかはかりうき身はなかきねをも鳴らん",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "伊香保沼",
   "kotobagaki": ""
  },
  {
   "seq": "25",
   "text": "この程の月日といかし朝ほらけさみたれつゝし天のかく山",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "天香俱山",
   "kotobagaki": ""
  },
  {
   "seq": "26",
   "text": "露をたれいく野にわけん大に山こえ行かたは白雨の諸",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "大江山",
   "kotobagaki": ""
  },
  {
   "seq": "27",
   "text": "一難波江や夕のしきみの下くゝるをとにもちかき水の秋風",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "難波江",
   "kotobagaki": ""
  },
  {
   "seq": "28",
   "text": "〽くり玉そ見つの見まきのまこも草おひ行まゝにしほれんもうし",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "美豆御救",
   "kotobagaki": ""
  },
  {
   "seq": "29",
   "text": "身の秋や松浦の山にゆく年のなかはをしたふ波もこえつゝ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松浦山",
   "kotobagaki": ""
  },
  {
   "seq": "30",
   "text": "初瀬山河音すみて暮る日の影よりむかふ秋のはつかせ",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "泊瀬山",
   "kotobagaki": ""
  },
  {
   "seq": "31",
   "text": "らす霧の龍田の山の木間よりまついろかはる秋の初風",
   "kana": "",
   "speaker": "",
   "page": 4,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "新田山",
   "kotobagaki": ""
  },
  {
   "seq": "32",
   "text": "〽くれ渡かすまの浦舟をひ風にはやくも出て見ゆる同哉",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "須磨浦",
   "kotobagaki": ""
  },
  {
   "seq": "33",
   "text": "袖ぬれて木の下露にやとりせは物や思はん宮城のゝはら",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "宮城野",
   "kotobagaki": ""
  },
  {
   "seq": "34",
   "text": "水くきの岡のくす葉はうらむ廿月待程の秋の夕風",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "水豆岡",
   "kotobagaki": ""
  },
  {
   "seq": "35",
   "text": "かま雲のをくらの山にかく鹿やよそにつれなき妻五侘ちん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "小倉山",
   "kotobagaki": ""
  },
  {
   "seq": "36",
   "text": "川音にたか枕にかくたくらん秋風寒き宇治の山かせ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "宇治川",
   "kotobagaki": ""
  },
  {
   "seq": "37",
   "text": "一袖の立もかはる常盤の森の露かゝるを見すは秋や恨らん",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "常磐山",
   "kotobagaki": ""
  },
  {
   "seq": "38",
   "text": "一時雨こし見むろの梢いかならんこの山陰も妹風そふく",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "三宝山",
   "kotobagaki": ""
  },
  {
   "seq": "39",
   "text": "たかまとの小野の萩原分きても我すり衣色にやはみむ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "高国野",
   "kotobagaki": ""
  },
  {
   "seq": "40",
   "text": "一れても紅葉やすらんいこま山見つゝ行来の空なかくしそ",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "伊物山",
   "kotobagaki": ""
  },
  {
   "seq": "41",
   "text": "たれかおもふかく田の池におかをしの声もあはれにふくる夜の月",
   "kana": "",
   "speaker": "",
   "page": 5,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "生田池",
   "kotobagaki": ""
  },
  {
   "seq": "42",
   "text": "清見かたおき行月の跡まてはたれをかとめむ浪の関寺",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "清見肉",
   "kotobagaki": ""
  },
  {
   "seq": "43",
   "text": "なをさりの袖たに露はふきとをあさたち動し武蔵のゝ原",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "武蔵物",
   "kotobagaki": ""
  },
  {
   "seq": "44",
   "text": "思ふにもいまさらしなのあきのみかたえて世度る月の里人",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "伊吹山文科里",
   "kotobagaki": ""
  },
  {
   "seq": "45",
   "text": "露の身もいつさそはれん妊の風おもふみちなるしら川の内",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "白河関",
   "kotobagaki": ""
  },
  {
   "seq": "46",
   "text": "もゝ草の野嶋か崎の夕風にあきかきなみの花も散なり",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "野嶋崎",
   "kotobagaki": ""
  },
  {
   "seq": "47",
   "text": "わかれてはいつくの波に明石かたうらすむ月にかよふふね人",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "明石浦",
   "kotobagaki": ""
  },
  {
   "seq": "48",
   "text": "浪の間もなをせきかへせ又いつかあふくま河の秋のしからみ",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "阿武隈河",
   "kotobagaki": ""
  },
  {
   "seq": "49",
   "text": "水上の山もくもしてきよ酒や木の葉落行すゑの白波",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "清瀧川",
   "kotobagaki": ""
  },
  {
   "seq": "50",
   "text": "をしほ山麓の野への夕霜に遣き雲ふく峯のまつ風",
   "kana": "",
   "speaker": "",
   "page": 6,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "小塩山",
   "kotobagaki": ""
  },
  {
   "seq": "51",
   "text": "住吉のうらの春松雪ころし里とふあまの袖やさゆらん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "住吉浦",
   "kotobagaki": ""
  },
  {
   "seq": "52",
   "text": "ふりにける交野の見ゆき今はとせたれとひ出て跡をしたはん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "交配",
   "kotobagaki": ""
  },
  {
   "seq": "53",
   "text": "雪にきる田みのゝ嶋のゆふほたりそれや誰共見へぬさと人",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "田蓑嶋",
   "kotobagaki": ""
  },
  {
   "seq": "54",
   "text": "あらち山峯にこりしら雲も雪もいくへかはれぬ日をかさぬらん",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "有乳山",
   "kotobagaki": ""
  },
  {
   "seq": "55",
   "text": "色かへぬ松を見るたに悲しきをけさ白雪の浮嶋かはら",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浮嶋原",
   "kotobagaki": ""
  },
  {
   "seq": "56",
   "text": "霜さゆる安達原もしらまうしられぬ迄も松しき冬かな",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "安達原",
   "kotobagaki": ""
  },
  {
   "seq": "57",
   "text": "なれかしに今帰こん春をのみ松はいなはの山ふかくとも",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "稲葉山",
   "kotobagaki": ""
  },
  {
   "seq": "58",
   "text": "鏡山つゐにくれゆく年ことにもと見し影のかへる物かは",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鐘山",
   "kotobagaki": ""
  },
  {
   "seq": "59",
   "text": "さゝ竹の伏見の里のかり枕しきもならはぬ袖の露遣さ",
   "kana": "",
   "speaker": "",
   "page": 7,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "伏見里",
   "kotobagaki": ""
  },
  {
   "seq": "60",
   "text": "思ひたつ心のすゑもおほろけの霞のうらにまよふ舟人",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "霞浦",
   "kotobagaki": ""
  },
  {
   "seq": "61",
   "text": "思ふ事いはせの杜のいはすとももろぎの色やみゆらん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "石油森",
   "kotobagaki": ""
  },
  {
   "seq": "62",
   "text": "いつよりか君に心をつくはねやしけきなけきの露かりけん",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "筑波山",
   "kotobagaki": ""
  },
  {
   "seq": "63",
   "text": "浪こゆる袖のうら風立名をもおもふ方にはよるにそなき",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "袖浦",
   "kotobagaki": ""
  },
  {
   "seq": "64",
   "text": "くらへ見よわれをます田の池水にふかさもゑらぬ袖の涙も",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "益田池",
   "kotobagaki": ""
  },
  {
   "seq": "65",
   "text": "あた浪のたかしのはまの夕手はいへるしつきもかよひたえつゝ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "高師演",
   "kotobagaki": ""
  },
  {
   "seq": "66",
   "text": "人心はけしく見つるけしきよりさてやあはての森のこからし",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "一河波手森",
   "kotobagaki": ""
  },
  {
   "seq": "67",
   "text": "あはれとは思ふ心やしかすかのわたりわひつゝかよふ舟人",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "志賀須加渡",
   "kotobagaki": ""
  },
  {
   "seq": "68",
   "text": "こひあたるもまなの橋の夕塩にさすかこゝろのひかは見へつゝ",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浜名橋",
   "kotobagaki": ""
  },
  {
   "seq": "69",
   "text": "貝ひろふいそまのとしのあまをこめほさぬ袖とてたれにみせまし",
   "kana": "",
   "speaker": "",
   "page": 8,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "磯間浦",
   "kotobagaki": ""
  },
  {
   "seq": "70",
   "text": "一木間より身にしむ月はもり山のうきかり枕とふ人也かな",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "守山",
   "kotobagaki": ""
  },
  {
   "seq": "71",
   "text": "泣にて佐野の舟橋いかさまに思ひるわたりて身を頼むらん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "佐北舟橋",
   "kotobagaki": ""
  },
  {
   "seq": "72",
   "text": "波波とて何かはおしきいたつらにかへるあさかの沼のねぬおは",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "浅香沼",
   "kotobagaki": ""
  },
  {
   "seq": "73",
   "text": "かきりさへ浪にいつまて松嶋や松嶋やおしまぬ命あふにかへすは",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "松嶋",
   "kotobagaki": ""
  },
  {
   "seq": "74",
   "text": "ぬる玉の緒たえの橋に行かよふ夢をはかなみ猶や北まん",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "諸絶橋",
   "kotobagaki": ""
  },
  {
   "seq": "75",
   "text": "あさくもや人は心を見くまのゝ浦のはまゆふ幾重からぬを",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "三熊野",
   "kotobagaki": ""
  },
  {
   "seq": "76",
   "text": "あはれともおもひかけすやおきつ波よそになるみのこらみはてゝは",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "阿海浦",
   "kotobagaki": ""
  },
  {
   "seq": "77",
   "text": "なれきゆく二見のうらのふた道や風のさむしろ浪の手枕",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "二見浦",
   "kotobagaki": ""
  },
  {
   "seq": "78",
   "text": "吉野川かはをと遠く行水のあをねか見ねに月すみいたる",
   "kana": "",
   "speaker": "",
   "page": 9,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "芳野川",
   "kotobagaki": ""
  },
  {
   "seq": "79",
   "text": "わかひとゝめははてし鈴鹿川せきもか浪も行かへるらん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鈴鹿川",
   "kotobagaki": ""
  },
  {
   "seq": "80",
   "text": "われそたゝふしの高根の雪みんとおもふさのよそに積れる",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "冨士山",
   "kotobagaki": ""
  },
  {
   "seq": "81",
   "text": "別こし道にやわれもかへる山ありて世中さためなけれは",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "還山",
   "kotobagaki": ""
  },
  {
   "seq": "82",
   "text": "袖ぬれてやとゝふ松の夕波に見しにもとをしあまの橋立",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "天橋立",
   "kotobagaki": ""
  },
  {
   "seq": "83",
   "text": "うかふ瀬そ猶まつまるゝ飛鳥川けふまてのよに身はしつみても",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "明日香川",
   "kotobagaki": ""
  },
  {
   "seq": "84",
   "text": "秋風のいほもらすてし人はとへとは山松の雪のあけほの",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "鳥羽山",
   "kotobagaki": ""
  },
  {
   "seq": "85",
   "text": "うきにふる身をかへてさへ思ふ哉いへにあるなはたつの市人",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "辰市",
   "kotobagaki": ""
  },
  {
   "seq": "86",
   "text": "浪風もふけゐのうらの梶枕いかにしてかは夢をたのまん",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "吹飯浦",
   "kotobagaki": ""
  },
  {
   "seq": "87",
   "text": "白妙の雲井に見えて山姫の心をさらす布行のたき",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "布引滝",
   "kotobagaki": ""
  },
  {
   "seq": "88",
   "text": "たゆる名をのこさんよりは橋柱ありしなからの道をたてはや",
   "kana": "",
   "speaker": "",
   "page": 10,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "長柄橋",
   "kotobagaki": ""
  },
  {
   "seq": "89",
   "text": "やとりてもいかゝいをねんさ夜風のあられくたくる玉川の里は",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "玉河里",
   "kotobagaki": ""
  },
  {
   "seq": "90",
   "text": "思ふ事おたすはうき身朽もせてよにある名をやおふのうらおし",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "生浦",
   "kotobagaki": ""
  },
  {
   "seq": "91",
   "text": "かきりあれはこれよりこゆる峰もなし書に月雪のさやの中山",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "佐夜中山",
   "kotobagaki": ""
  },
  {
   "seq": "92",
   "text": "〽わひはてゝ今は我身のさかなにやきゆへき露の行来もとめん",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "嵯峨野",
   "kotobagaki": ""
  },
  {
   "seq": "93",
   "text": "思ふ人や有明の月の角田川わたりをとをくまつさしてゆく",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "隅田川",
   "kotobagaki": ""
  },
  {
   "seq": "94",
   "text": "市人のおも左荷を払ふ馬はあれとわひてしかまの歩よりそ行",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "志賀麻市",
   "kotobagaki": ""
  },
  {
   "seq": "95",
   "text": "つゐにわかにるへとまてはたのまねとかよひなれたか和歌の浦人",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "若浦",
   "kotobagaki": ""
  },
  {
   "seq": "96",
   "text": "くたりこし道を思へはゆくすゑのいかなる世にか違坂の関",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "相坂関",
   "kotobagaki": ""
  },
  {
   "seq": "97",
   "text": "君か代にあふみの海のしつかなるときやねかひも見つのみま松",
   "kana": "",
   "speaker": "",
   "page": 11,
   "pid": "nao-734034",
   "form": "短歌",
   "genre": "",
   "ban": "",
   "side": "",
   "dai": "御津濱",
   "kotobagaki": ""
  }
 ],
